# ===========================================
# Minecraft Server Monitor — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------- PostgreSQL (Render: use internal URL) ----------
POSTGRES_USER=minecraft
POSTGRES_PASSWORD=minecraft
POSTGRES_DB=minecraft_monitor

# For Spring Boot (Render Web Service):
# DB_URL=jdbc:postgresql://<render-internal-host>:5432/<dbname>
# DB_USERNAME=<user>
# DB_PASSWORD=<password>

# ---------- Security ----------
JWT_SECRET=change-me-to-a-strong-random-string

# ---------- Bootstrap Admin User ----------
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=change-me

# ---------- CORS ----------
# Comma-separated list of allowed origins.
# For production, set your Vercel URL:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Email Alerts (optional) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------- Alert Thresholds ----------
ALERT_LATENCY_THRESHOLD=500

# ---------- RCON (optional) ----------
RCON_PASSWORD=

# ---------- Webhook (optional) ----------
ALERT_WEBHOOK_URL=
